NEXT_PUBLIC_APP_NAME=Cartory Wash
API_INTERNAL_BASE_URL=http://localhost:4000/v1
# same value as carwash-api's API_SECURITY_KEY; required on Vercel
API_SECURITY_KEY=
# optional: WhatsApp number for the landing page's "Book a demo" form, international digits only
# (e.g. 2348030000000). Unset: the landing page says "Demo booking opens soon." Read at build time.
NEXT_PUBLIC_DEMO_WHATSAPP_NUMBER=
